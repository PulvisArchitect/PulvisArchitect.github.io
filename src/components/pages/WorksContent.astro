---
import { ui, type Locale } from '../../data/i18n';
import { works } from '../../data/site';
import WorkCard from '../WorkCard.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="pv-phead" style="--pv-maxw:1280px">
  <div class="pv-kicker">
    <span class="pv-kicker__dot"></span>
    <span class="pv-kicker__label">{t.works.kicker}</span>
  </div>
  <h1 class="pv-page-title">{t.works.title}</h1>
  <p class="pv-lead">{t.works.lead}</p>
</section>

<section class="pv-works-section">
  <div class="pv-works-grid">
    {works.map((work) => <WorkCard work={work} lang={lang} showCategory />)}
  </div>
</section>

<style>
  .pv-works-section {
    padding: clamp(32px, 4.5vw, 48px) var(--pv-pad-x) clamp(48px, 6vw, 72px);
    max-width: 1280px;
    margin: 0 auto;
  }
</style>
