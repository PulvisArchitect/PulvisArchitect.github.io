---
import { ui, localizedHref, type Locale } from '../../data/i18n';
import { works, events, slides } from '../../data/site';
import WorkCard from '../WorkCard.astro';
import EventRow from '../EventRow.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const homeWorks = works.slice(0, 3);
const homeEvents = events.slice(0, 3);
const featured = slides[0];
const slideMeta = `${featured.date} — ${featured.event[lang]}`;
---

<!-- Hero -->
<section class="pv-hero">
  <div class="pv-hero__text">
    <div class="pv-kicker pv-hero__kicker">
      <span class="pv-kicker__dot"></span>
      <span class="pv-kicker__label">{t.home.kicker}</span>
    </div>
    <h1 class="pv-hero__title">{t.home.title}</h1>
    <p class="pv-hero__desc">{t.home.desc}</p>
    <div class="pv-hero__cta">
      <a class="pv-link" href={localizedHref(lang, 'works')}>{t.home.ctaWorks} →</a>
      <a class="pv-link--muted" href={localizedHref(lang, 'about')}>{t.home.ctaAbout} →</a>
    </div>
  </div>
  <div class="pv-hero__media">
    <div class="pv-hero__frame">
      <img src="/img/pulvis.png" alt="" />
    </div>
  </div>
</section>

<!-- Works -->
<section class="pv-section">
  <div class="pv-sechead">
    <h2 class="pv-sechead__h2">{t.home.worksHeading}</h2>
    <span class="pv-sechead__label">{t.home.worksLabel}</span>
    <a class="pv-link pv-sechead__all" href={localizedHref(lang, 'works')}>{t.viewAll} →</a>
  </div>
  <div class="pv-works-grid" style="--pv-work-min:240px">
    {homeWorks.map((work) => <WorkCard work={work} lang={lang} />)}
  </div>
</section>

<!-- Events -->
<section class="pv-section">
  <div class="pv-sechead">
    <h2 class="pv-sechead__h2">{t.home.eventsHeading}</h2>
    <span class="pv-sechead__label">{t.home.eventsLabel}</span>
    <a class="pv-link pv-sechead__all" href={localizedHref(lang, 'events')}>{t.viewAll} →</a>
  </div>
  <div>
    {homeEvents.map((event) => <EventRow event={event} lang={lang} variant="line" />)}
  </div>
</section>

<!-- Slides -->
<section class="pv-section">
  <div class="pv-sechead">
    <h2 class="pv-sechead__h2">{t.home.slidesHeading}</h2>
    <span class="pv-sechead__label">{t.home.slidesLabel}</span>
    <a class="pv-link pv-sechead__all" href={localizedHref(lang, 'slides')}>{t.viewAll} →</a>
  </div>
  <div class="pv-slidebanner">
    <div>
      <div class="pv-meta pv-slidebanner__meta">{slideMeta}</div>
      <div class="pv-slidebanner__title">{featured.title[lang]}</div>
    </div>
    <div class="pv-slidebanner__links">
      <a class="pv-link" href={featured.web}>{t.home.slideWeb} →</a>
      <a class="pv-link--muted" href={featured.pdf}>{t.home.slidePdf} →</a>
    </div>
  </div>
</section>

<style>
  .pv-hero {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: clamp(32px, 5vw, 64px);
    padding: clamp(48px, 8vw, 72px) var(--pv-pad-x) clamp(48px, 6vw, 64px);
    border-bottom: 1px solid var(--pv-border);
    max-width: 1280px;
    margin: 0 auto;
    align-items: center;
  }
  .pv-hero__text {
    min-width: 0;
  }
  .pv-hero__kicker {
    margin-bottom: 22px;
  }
  .pv-hero__title {
    margin: 0 0 26px;
    font-family: var(--pv-serif);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw + 8px, 42px);
    line-height: 1.5;
    color: var(--pv-ink);
    text-wrap: balance;
  }
  .pv-hero__desc {
    margin: 0 0 32px;
    font-size: 16px;
    line-height: 1.95;
    color: rgba(27, 34, 44, 0.75);
    max-width: 46ch;
    word-break: auto-phrase;
    text-wrap: pretty;
  }
  .pv-hero__cta {
    display: flex;
    gap: clamp(20px, 3vw, 36px);
    flex-wrap: wrap;
    font-size: 14px;
  }
  .pv-hero__media {
    min-width: 0;
  }
  .pv-hero__frame {
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 1px solid rgba(27, 34, 44, 0.16);
    overflow: hidden;
    background: var(--pv-panel-alt);
  }
  .pv-hero__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pv-section {
    padding: clamp(32px, 4.5vw, 48px) var(--pv-pad-x);
    border-bottom: 1px solid var(--pv-border);
    max-width: 1280px;
    margin: 0 auto;
  }

  .pv-sechead {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .pv-sechead__h2 {
    margin: 0;
    font-family: var(--pv-serif);
    font-weight: 700;
    font-size: 24px;
    color: var(--pv-ink);
  }
  .pv-sechead__label {
    font-size: 13px;
    color: var(--pv-ink-78);
  }
  .pv-sechead__all {
    margin-left: auto;
    font-size: 13px;
    white-space: nowrap;
  }

  .pv-slidebanner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    padding: 24px 28px;
    border: 1px solid var(--pv-border);
    background: var(--pv-panel);
  }
  .pv-slidebanner__meta {
    color: var(--pv-ink-78);
    margin-bottom: 8px;
  }
  .pv-slidebanner__title {
    font-family: var(--pv-serif);
    font-size: 20px;
    color: var(--pv-ink);
  }
  .pv-slidebanner__links {
    display: flex;
    gap: 24px;
    font-size: 13px;
  }
</style>
