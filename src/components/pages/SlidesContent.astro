---
import { ui, type Locale } from '../../data/i18n';
import { slides } from '../../data/site';
import SlideRow from '../SlideRow.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="pv-phead" style="--pv-maxw:1080px">
  <div class="pv-kicker">
    <span class="pv-kicker__dot"></span>
    <span class="pv-kicker__label">{t.slides.kicker}</span>
  </div>
  <h1 class="pv-page-title">{t.slides.title}</h1>
  <p class="pv-lead">{t.slides.lead}</p>
</section>

<section class="pv-slides-section">
  <div class="pv-slides-list">
    {slides.map((slide) => <SlideRow slide={slide} lang={lang} />)}
  </div>
</section>

<style>
  .pv-slides-section {
    padding: clamp(24px, 3vw, 36px) var(--pv-pad-x) clamp(48px, 6vw, 72px);
    max-width: 1080px;
    margin: 0 auto;
  }
  .pv-slides-list {
    border-top: 1px solid var(--pv-border);
  }
</style>
