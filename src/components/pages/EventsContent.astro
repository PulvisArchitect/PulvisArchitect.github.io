---
import { ui, type Locale } from '../../data/i18n';
import { events } from '../../data/site';
import EventRow from '../EventRow.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="pv-phead" style="--pv-maxw:1080px">
  <div class="pv-kicker">
    <span class="pv-kicker__dot"></span>
    <span class="pv-kicker__label">{t.events.kicker}</span>
  </div>
  <h1 class="pv-page-title">{t.events.title}</h1>
  <p class="pv-lead">{t.events.lead}</p>
</section>

<section class="pv-events-section">
  <div class="pv-events-list">
    {events.map((event) => <EventRow event={event} lang={lang} variant="list" />)}
  </div>
  <p class="pv-events-note">{t.events.note}</p>
</section>

<style>
  .pv-events-section {
    padding: clamp(24px, 3vw, 36px) var(--pv-pad-x) clamp(48px, 6vw, 72px);
    max-width: 1080px;
    margin: 0 auto;
  }
  .pv-events-list {
    border-top: 1px solid var(--pv-border);
  }
  .pv-events-note {
    margin: 28px 0 0;
    font-size: 13px;
    line-height: 1.8;
    color: var(--pv-ink-60);
  }
</style>
