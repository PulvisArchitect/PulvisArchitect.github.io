---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Locale } from '../data/i18n';

interface Props {
  lang: Locale;
  currentKey: string;
  title?: string;
}

const { lang, currentKey, title } = Astro.props;
const t = ui[lang];
const pageTitle = title ? `${title} — ${t.siteTitle}` : t.siteTitle;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="shortcut icon" href="/img/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} currentKey={currentKey} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
